@model IEnumerable<RevisaoMVCAtividade2.Models.Item>

<h1>Lista de Itens</h1>

<table>
    <thead>
        <tr>
            <th>Nome</th>
            <th>Quantidade</th>
            <th>Comprado</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nome</td>
                <td>@item.Quantidade</td>
                <td>
                    @(item.Comprado ? "Sim" : "Não")
                </td>
            </tr>
        }
    </tbody>
</table>